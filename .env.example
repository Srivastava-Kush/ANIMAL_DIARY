# ---------------------------------------------------------------------------
# Environment variables for Animal Diary + Crawl & Review.
# Copy to ".env" for local overrides. Vite only exposes vars prefixed VITE_.
# ---------------------------------------------------------------------------

# FRONTEND (build-time, baked into the static bundle by Vite)
# Leave EMPTY for local dev (requests hit the Vite dev middleware on same origin).
# In production set this to your deployed API service URL.
VITE_API_BASE_URL=

# BACKEND (runtime, used by server/index.js — set these on the Render API service)
# PORT is provided automatically by Render; only set locally if you want.
PORT=8787
# Your static-site origin for CORS (comma-separate multiple; "*" allows any).
FRONTEND_ORIGIN=*
# Optional: absolute path to a persistent data dir (e.g. a Render Disk mount).
# Defaults to ./src/data when unset.
DATA_DIR=
